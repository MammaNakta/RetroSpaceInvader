# ==============================================================================
# Unity .gitattributes
# ==============================================================================

# Auto detect text files and perform LF normalization
* text=auto

# Text files line ending & diff
*.cs text diff=csharp eol=lf
*.cginc text eol=lf
*.shader text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.txt text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Unity YAML assets
# NOTE: If you have UnityYAMLMerge configured in your gitconfig,
# you can replace 'text eol=lf' with 'merge=unityyamlmerge eol=lf'.
*.mat text eol=lf
*.anim text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.physicsMaterial2D text eol=lf
*.physicMaterial text eol=lf
*.asset text eol=lf
*.meta text eol=lf
*.controller text eol=lf
*.overrideController text eol=lf
*.mask text eol=lf
*.guiskin text eol=lf

# ==============================================================================
# 2D Retro Game Assets (Managed via Git binary directly for light weight & zero-LFS quota)
# ==============================================================================
*.png binary
*.jpg binary
*.jpeg binary
*.wav binary
*.mp3 binary
*.ogg binary

# ==============================================================================
# Git LFS (Large File Storage - for heavy 3D, raw design files, videos, binaries)
# ==============================================================================

# 3D Models
*.fbx filter=lfs diff=lfs merge=lfs -text
*.obj filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.dae filter=lfs diff=lfs merge=lfs -text
*.3ds filter=lfs diff=lfs merge=lfs -text
*.max filter=lfs diff=lfs merge=lfs -text

# Raw Textures & High-Res Images
*.psd filter=lfs diff=lfs merge=lfs -text
*.tga filter=lfs diff=lfs merge=lfs -text
*.tif filter=lfs diff=lfs merge=lfs -text
*.tiff filter=lfs diff=lfs merge=lfs -text
*.hdr filter=lfs diff=lfs merge=lfs -text
*.exr filter=lfs diff=lfs merge=lfs -text

# Video
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.mov filter=lfs diff=lfs merge=lfs -text
*.avi filter=lfs diff=lfs merge=lfs -text
*.webm filter=lfs diff=lfs merge=lfs -text

# Heavy Audio (Uncompressed multitrack or AIFF/FLAC)
*.aif filter=lfs diff=lfs merge=lfs -text
*.aiff filter=lfs diff=lfs merge=lfs -text
*.flac filter=lfs diff=lfs merge=lfs -text

# Compressed Archives
*.zip filter=lfs diff=lfs merge=lfs -text
*.7z filter=lfs diff=lfs merge=lfs -text
*.tar.gz filter=lfs diff=lfs merge=lfs -text
*.rar filter=lfs diff=lfs merge=lfs -text

# Fonts
*.ttf filter=lfs diff=lfs merge=lfs -text
*.otf filter=lfs diff=lfs merge=lfs -text
*.ttc filter=lfs diff=lfs merge=lfs -text

# Compiled Binaries & Dynamic Libraries
*.dll filter=lfs diff=lfs merge=lfs -text
*.so filter=lfs diff=lfs merge=lfs -text
*.dylib filter=lfs diff=lfs merge=lfs -text
